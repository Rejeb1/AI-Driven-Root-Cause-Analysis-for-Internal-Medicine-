# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.venv/
venv/

# Downloaded source data. Both are reproducible from a documented command, and
# together they are large enough to make the repository awkward to clone:
#   hp.obo            -> scripts/build_vocabulary.py
#   ddxplus/          -> figshare.com/articles/dataset/DDXPlus_Dataset/20043374
# data/vocabulary.json is deliberately NOT ignored: it is the frozen concept
# layer and pinning it is what makes a run reproducible.
data/hp.obo
data/ddxplus/
*.zip

# Evaluation artefacts
*.eval.json

# Machine-local tool settings: absolute paths from one developer's machine,
# meaningless and mildly confusing anywhere else.
.claude/settings.local.json

# API keys, read at runtime and never committed. The scripts take their keys
# from the environment precisely so no key needs to live in a file; these
# patterns exist so that one written down for convenience cannot be committed
# by accident.
.env
*.key
.gemini_key
.anthropic_key

# Generated synthetic corpora. Regenerable from scripts/synthesize.py, and
# model-dependent -- committing one would pin a corpus written by whichever
# model happened to be reachable that day into a repository that otherwise
# regenerates its data from documented commands.
cases.json
*.cases.json
